{
  "v": 1,
  "id": "dev_repo",
  "roots": [
    {
      "name": "repo",
      "type": "repo",
      "label": "current repository",
      "resource": { "kind": "path", "value": "." }
    },
    {
      "name": "tests",
      "type": "tests",
      "label": "repository test suite",
      "resource": { "kind": "path", "value": "." }
    },
    {
      "name": "git",
      "type": "git",
      "label": "repository history",
      "resource": { "kind": "path", "value": "." }
    },
    {
      "name": "episodes",
      "type": "episodes",
      "label": "session episode history",
      "resource": { "kind": "logical", "value": "episodes" }
    }
  ],
  "handle_types": {
    "repo": {
      "verbs": {
        "read": {
          "args_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": { "path": { "type": "string", "minLength": 1 } }
          },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content", "digest"],
            "properties": {
              "path": { "type": "string" },
              "content": { "type": "string" },
              "digest": { "type": "string" }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": [
            {
              "id": "path_outside_repo",
              "when": {
                "properties": {
                  "failure": {
                    "properties": { "code": { "const": "path_outside_repo" } },
                    "required": ["code"]
                  }
                },
                "required": ["failure"]
              },
              "what": "repo.read declined the path",
              "why": "the path is outside the reachable repository",
              "instead": null,
              "no_alternative": "use a relative path inside the repository"
            }
          ]
        },
        "edit": {
          "args_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "old", "new"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "old": { "type": "string", "minLength": 1 },
              "new": { "type": "string" }
            }
          },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "changed", "digest"],
            "properties": {
              "path": { "type": "string" },
              "changed": { "type": "boolean" },
              "digest": { "type": "string" }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": [
            {
              "id": "path_outside_repo",
              "when": {
                "properties": {
                  "failure": {
                    "properties": { "code": { "const": "path_outside_repo" } },
                    "required": ["code"]
                  }
                },
                "required": ["failure"]
              },
              "what": "repo.edit declined the path",
              "why": "the path is outside the reachable repository",
              "instead": null,
              "no_alternative": "use a relative path inside the repository"
            },
            {
              "id": "edit_conflict",
              "when": {
                "properties": {
                  "failure": {
                    "properties": { "code": { "const": "edit_conflict" } },
                    "required": ["code"]
                  }
                },
                "required": ["failure"]
              },
              "what": "repo.edit declined the replacement",
              "why": "the expected text did not match exactly once",
              "instead": null,
              "no_alternative": "read the current file and retry with an exact match"
            }
          ]
        },
        "build": {
          "args_schema": { "type": "object", "additionalProperties": false },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exit_code", "stdout", "stderr"],
            "properties": {
              "exit_code": { "type": "integer" },
              "stdout": { "type": "string" },
              "stderr": { "type": "string" }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": []
        },
        "find": {
          "args_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query"],
            "properties": { "query": { "type": "string", "minLength": 1 } }
          },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["matches"],
            "properties": {
              "matches": { "type": "array", "items": { "type": "string" } }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": []
        },
        "status": {
          "args_schema": { "type": "object", "additionalProperties": false },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["branch", "clean"],
            "properties": {
              "branch": { "type": "string" },
              "clean": { "type": "boolean" }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": []
        }
      }
    },
    "tests": {
      "verbs": {
        "run": {
          "args_schema": { "type": "object", "additionalProperties": false },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exit_code", "passed", "failed", "stdout", "stderr"],
            "properties": {
              "exit_code": { "type": "integer" },
              "passed": { "type": "integer", "minimum": 0 },
              "failed": { "type": "integer", "minimum": 0 },
              "stdout": { "type": "string" },
              "stderr": { "type": "string" }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": []
        },
        "list": {
          "args_schema": { "type": "object", "additionalProperties": false },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tests", "renames"],
            "properties": {
              "tests": { "type": "array", "items": { "type": "string" } },
              "renames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["from", "to"],
                  "properties": {
                    "from": { "type": "string", "minLength": 1 },
                    "to": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": []
        },
        "focus": {
          "args_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["test"],
            "properties": { "test": { "type": "string", "minLength": 1 } }
          },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["test", "passed", "exit_code", "stdout", "stderr"],
            "properties": {
              "test": { "type": "string" },
              "passed": { "type": "boolean" },
              "exit_code": { "type": "integer" },
              "stdout": { "type": "string" },
              "stderr": { "type": "string" }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": [
            {
              "id": "missing_test",
              "when": {
                "properties": { "args": { "not": { "required": ["test"] } } },
                "required": ["args"]
              },
              "what": "tests.focus requires a test name",
              "why": "the requested test was not bound",
              "instead": {
                "handle": { "source": "self" },
                "verb": "list",
                "args": {}
              }
            },
            {
              "id": "unknown_test",
              "when": {
                "properties": {
                  "failure": {
                    "properties": { "code": { "const": "unknown_test" } },
                    "required": ["code"]
                  }
                },
                "required": ["failure"]
              },
              "what": "tests.focus declined the test name",
              "why": "the requested test is not in the live suite",
              "instead": {
                "handle": { "source": "self" },
                "verb": "list",
                "args": {}
              }
            },
            {
              "id": "stale_suite",
              "when": {
                "properties": {
                  "failure": {
                    "properties": { "code": { "const": "stale_state" } },
                    "required": ["code"]
                  }
                },
                "required": ["failure"]
              },
              "what": "tests.focus declined stale suite state",
              "why": "the test suite changed after the call was suggested",
              "instead": {
                "handle": { "source": "self" },
                "verb": "list",
                "args": {}
              }
            }
          ]
        }
      }
    },
    "git": {
      "verbs": {
        "status": {
          "args_schema": { "type": "object", "additionalProperties": false },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["branch", "clean", "output"],
            "properties": {
              "branch": { "type": "string" },
              "clean": { "type": "boolean" },
              "output": { "type": "string" }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": []
        },
        "diff": {
          "args_schema": { "type": "object", "additionalProperties": false },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["diff"],
            "properties": { "diff": { "type": "string" } }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": []
        },
        "commit": {
          "args_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["message"],
            "properties": { "message": { "type": "string", "minLength": 1, "maxLength": 200 } }
          },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["committed", "stdout", "stderr"],
            "properties": {
              "committed": { "type": "boolean" },
              "stdout": { "type": "string" },
              "stderr": { "type": "string" }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": [
            {
              "id": "nothing_to_commit",
              "when": {
                "properties": {
                  "failure": {
                    "properties": { "code": { "const": "nothing_to_commit" } },
                    "required": ["code"]
                  }
                },
                "required": ["failure"]
              },
              "what": "git.commit cannot run",
              "why": "no changes are available to commit",
              "instead": null,
              "no_alternative": "make a reachable edit before committing"
            }
          ]
        }
      }
    },
    "episodes": {
      "verbs": {
        "recall": {
          "args_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query"],
            "properties": { "query": { "type": "string", "minLength": 1 } }
          },
          "result_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["episodes"],
            "properties": {
              "episodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["episode_id", "act_id"],
                  "properties": {
                    "episode_id": { "type": "string" },
                    "act_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "grants": [],
          "may_revoke": false,
          "refusals": [
            {
              "id": "recall_unavailable",
              "when": {
                "properties": {
                  "failure": {
                    "properties": { "code": { "const": "recall_unavailable" } },
                    "required": ["code"]
                  }
                },
                "required": ["failure"]
              },
              "what": "episodes.recall cannot run",
              "why": "the episode store has not started",
              "instead": null,
              "no_alternative": "start the episode store before recalling history"
            }
          ]
        }
      }
    }
  },
  "activations": [
    {
      "id": "diagnose_complete_suite",
      "pattern": "(?i)(determine|diagnose|why).*(complete|suite).*(not green|fail|exact)",
      "suggestions": [
        {
          "call": { "handle": { "source": "root", "name": "repo" }, "verb": "status", "args": {} },
          "why": "establish repository state before suite diagnosis",
          "score": 1
        }
      ]
    },
    {
      "id": "run_complete_suite",
      "pattern": "(?i)^\\s*(run|execute).*(complete|entire|full).*(test|suite)",
      "suggestions": [
        {
          "call": { "handle": { "source": "root", "name": "tests" }, "verb": "run", "args": {} },
          "why": "run the complete reachable test suite",
          "score": 0
        }
      ]
    },
    {
      "id": "focus_named_test",
      "pattern": "\\b(Test[A-Za-z0-9_]+)\\b",
      "suggestions": [
        {
          "call": {
            "handle": { "source": "root", "name": "tests" },
            "verb": "focus",
            "args": { "test": { "intent_capture": 1 } }
          },
          "why": "run the test named in the intent",
          "score": 1
        }
      ]
    },
    {
      "id": "discover_internal_service_test",
      "pattern": "(?i)find.*internal.*test.*public\\s+([A-Za-z0-9_-]+)\\s+service",
      "suggestions": [
        {
          "call": {
            "handle": { "source": "root", "name": "repo" },
            "verb": "find",
            "args": { "query": { "intent_capture": 1 } }
          },
          "why": "bridge the public service name through repository search",
          "score": 1
        }
      ]
    },
    {
      "id": "list_contextual_test",
      "pattern": "(?i)(first test|current [A-Za-z0-9_-]* ?test|whether .* test passes)",
      "suggestions": [
        {
          "call": { "handle": { "source": "root", "name": "tests" }, "verb": "list", "args": {} },
          "why": "bind the requested test from the live suite",
          "score": 0
        }
      ]
    },
    {
      "id": "build_repository",
      "pattern": "(?i)\\b(compile|compiles|builds)\\b",
      "suggestions": [
        {
          "call": { "handle": { "source": "root", "name": "repo" }, "verb": "build", "args": {} },
          "why": "check whether the reachable repository builds",
          "score": 1
        }
      ]
    }
  ],

  "transitions": [
    {
      "id": "status_to_run",
      "match": { "handle_type": "repo", "verb": "status", "status": "ok", "result_when": {} },
      "suggestions": [
        {
          "call": { "handle": { "source": "root", "name": "tests" }, "verb": "run", "args": {} },
          "why": "establish the suite baseline before diagnosis",
          "score": 1
        }
      ]
    },
    {
      "id": "build_failure_next",
      "match": {
        "handle_type": "repo",
        "verb": "build",
        "status": "ok",
        "result_when": { "properties": { "exit_code": { "minimum": 1 } }, "required": ["exit_code"] }
      },
      "suggestions": [
        {
          "call": { "handle": { "source": "root", "name": "git" }, "verb": "diff", "args": {} },
          "why": "inspect changes related to the build failure",
          "score": 1
        },
        {
          "call": { "handle": { "source": "root", "name": "tests" }, "verb": "run", "args": {} },
          "why": "separate test failures from build failures",
          "score": 0
        },
        {
          "call": {
            "handle": { "source": "root", "name": "episodes" },
            "verb": "recall",
            "args": { "query": { "result_pointer": "/stderr" } }
          },
          "why": "recall fixes for this failure output",
          "score": 0
        }
      ]
    },
    {
      "id": "test_failure_next",
      "match": {
        "handle_type": "tests",
        "verb": "run",
        "status": "ok",
        "result_when": { "properties": { "failed": { "minimum": 1 } }, "required": ["failed"] }
      },
      "suggestions": [
        {
          "call": { "handle": { "source": "self" }, "verb": "list", "args": {} },
          "why": "list tests before focusing the failure",
          "score": 1
        }
      ]
    },
    {
      "id": "edit_changed_next",
      "match": {
        "handle_type": "repo",
        "verb": "edit",
        "status": "ok",
        "result_when": { "properties": { "changed": { "const": true } }, "required": ["changed"] }
      },
      "suggestions": [
        {
          "call": { "handle": { "source": "root", "name": "tests" }, "verb": "run", "args": {} },
          "why": "run tests affected by the edit",
          "score": 1
        },
        {
          "call": { "handle": { "source": "root", "name": "git" }, "verb": "diff", "args": {} },
          "why": "inspect the resulting edit",
          "score": 0
        }
      ]
    },
    {
      "id": "test_list_focus_next",
      "match": {
        "handle_type": "tests",
        "verb": "list",
        "status": "ok",
        "result_when": { "properties": { "tests": { "minItems": 1 } }, "required": ["tests"] }
      },
      "suggestions": [
        {
          "call": {
            "handle": { "source": "self" },
            "verb": "focus",
            "args": { "test": { "result_pointer": "/tests/0" } },
            "state": { "state_digest": true }
          },
          "why": "complete the requested check with the bound live test",
          "score": 1
        }
      ]
    },
    {
      "id": "find_match_next",
      "match": {
        "handle_type": "repo",
        "verb": "find",
        "status": "ok",
        "result_when": { "properties": { "matches": { "minItems": 1 } }, "required": ["matches"] }
      },
      "suggestions": [
        {
          "call": {
            "handle": { "source": "self" },
            "verb": "read",
            "args": { "path": { "result_pointer": "/matches/0" } }
          },
          "why": "inspect the first matching repository file",
          "score": 1
        }
      ]
    }
  ]
}
