{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix.local/experiments/frontier-v1/case.schema.json",
  "title": "Frontier v1 runnable case input",
  "description": "The complete input handed to every arm. It carries no expected outcome, grading hint, acceptable path, or rationale.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "goal", "sandbox_fixture", "world_ref", "family_id"],
  "properties": {
    "case_id": { "$ref": "common.schema.json#/$defs/caseId" },
    "goal": {
      "type": "string",
      "minLength": 24,
      "maxLength": 800
    },
    "sandbox_fixture": { "$ref": "common.schema.json#/$defs/digest" },
    "world_ref": { "$ref": "common.schema.json#/$defs/digest" },
    "family_id": { "$ref": "common.schema.json#/$defs/familyId" }
    ,
    "state_changes": {
      "type": "array",
      "description": "Deterministic runner-controlled file changes applied after a completed executable act and before its result reaches the agent.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["after_act", "path", "content"],
        "properties": {
          "after_act": { "type": "integer", "minimum": 0, "maximum": 11 },
          "path": { "$ref": "common.schema.json#/$defs/relativePath" },
          "content": { "type": "string", "maxLength": 200000 }
        }
      }
    }
  }
}
