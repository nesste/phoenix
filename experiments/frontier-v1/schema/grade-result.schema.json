{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix.local/experiments/frontier-v1/grade-result.schema.json",
  "title": "Frontier v1 deterministic grade result",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "checks", "status"],
  "properties": {
    "case_id": { "$ref": "common.schema.json#/$defs/caseId" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "verdict", "reason", "gating"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "kind": { "$ref": "common.schema.json#/$defs/identifier" },
          "verdict": { "enum": ["pass", "fail", "manual_required"] },
          "reason": { "type": "string", "minLength": 1 },
          "gating": {
            "type": "boolean",
            "description": "Whether this check's verdict participates in the overall status under the frozen per-class check-kind classification. Descriptive checks are reported but cannot fail the trial."
          }
        }
      }
    },
    "status": { "enum": ["pass", "fail", "indeterminate"] }
  }
}
