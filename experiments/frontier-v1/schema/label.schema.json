{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix.local/experiments/frontier-v1/label.schema.json",
  "title": "Frontier v1 case label",
  "description": "The outcome-bearing half of a case. Only the authoring tranche keeps this content in the repository; sealed tranches contribute a digest and nothing else.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "class", "expected_outcome", "grading_script", "acceptable_paths", "label_rationale"],
  "properties": {
    "case_id": { "$ref": "common.schema.json#/$defs/caseId" },
    "class": {
      "description": "Evaluator-only class metadata. It is never included in the runnable case handed to an agent.",
      "$ref": "common.schema.json#/$defs/caseClass"
    },
    "expected_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        }
      }
    },
    "grading_script": {
      "description": "Digest of the complete grader artifact that evaluates the checks.",
      "$ref": "common.schema.json#/$defs/digest"
    },
    "acceptable_paths": {
      "type": "array",
      "description": "Non-exhaustive verb sequences considered correct. An empty sequence records that no acting path is expected.",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": { "$ref": "common.schema.json#/$defs/verbPath" }
      }
    },
    "label_rationale": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    }
  },
  "$defs": {
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "mode"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "act_sequence" },
            "mode": { "enum": ["exact", "contains_in_order"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "maximum"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "act_count" },
            "maximum": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "path"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "act_path_absent" },
            "path": {
              "description": "A handle type or exact handle-type.verb path that must not occur.",
              "$ref": "common.schema.json#/$defs/verbPath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "seq", "status"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "act_status" },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "description": "Zero-based position in the acceptable path matched by the act_sequence check. If no act_sequence check exists, this is an absolute trial act index. Sequence-index addressing is legal only for descriptive checks and for path-primary classes; gating act-addressed checks in outcome-primary classes use the selector-addressed form."
            },
            "status": { "enum": ["ok", "fail", "refused", "absent"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "selector_mode", "path", "status"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "act_status" },
            "selector_mode": {
              "enum": ["some", "last"],
              "description": "Selector addressing: \"some\" (default form) passes when some act matching the path predicate satisfies the check; \"last\" binds the last matching act and is permitted only where recency is the construct under test."
            },
            "path": {
              "description": "The exact handle-type.verb predicate the selector matches against trial acts.",
              "$ref": "common.schema.json#/$defs/verbPath"
            },
            "status": { "enum": ["ok", "fail", "refused", "absent"] },
            "recency_rationale": {
              "type": "string",
              "minLength": 16,
              "maxLength": 400,
              "description": "Required with last-mode selection: why recency is the construct under test. The payload's independent review checks every last-mode use against its rationale."
            }
          },
          "allOf": [
            {
              "if": { "properties": { "selector_mode": { "const": "last" } }, "required": ["selector_mode"] },
              "then": { "required": ["recency_rationale"] },
              "else": { "not": { "required": ["recency_rationale"] } }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "seq", "pattern"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "act_output_matches" },
            "seq": {
              "type": "integer",
              "minimum": 0,
              "description": "Zero-based position in the acceptable path matched by the act_sequence check. If no act_sequence check exists, this is an absolute trial act index. Sequence-index addressing is legal only for descriptive checks and for path-primary classes; gating act-addressed checks in outcome-primary classes use the selector-addressed form."
            },
            "pattern": { "type": "string", "minLength": 1 },
            "negate": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "selector_mode", "path", "pattern"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "act_output_matches" },
            "selector_mode": {
              "enum": ["some", "last"],
              "description": "Selector addressing: \"some\" (default form) passes when some act matching the path predicate satisfies the check; \"last\" binds the last matching act and is permitted only where recency is the construct under test."
            },
            "path": {
              "description": "The exact handle-type.verb predicate the selector matches against trial acts.",
              "$ref": "common.schema.json#/$defs/verbPath"
            },
            "pattern": { "type": "string", "minLength": 1 },
            "negate": { "type": "boolean" },
            "recency_rationale": {
              "type": "string",
              "minLength": 16,
              "maxLength": 400,
              "description": "Required with last-mode selection: why recency is the construct under test. The payload's independent review checks every last-mode use against its rationale."
            }
          },
          "allOf": [
            {
              "if": { "properties": { "selector_mode": { "const": "last" } }, "required": ["selector_mode"] },
              "then": { "required": ["recency_rationale"] },
              "else": { "not": { "required": ["recency_rationale"] } }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "path", "pattern"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "file_matches" },
            "path": { "$ref": "common.schema.json#/$defs/relativePath" },
            "pattern": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "path"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "file_absent" },
            "path": { "$ref": "common.schema.json#/$defs/relativePath" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "command", "exit_code"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "command_exit" },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "command", "pattern"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "command_output_matches" },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "pattern": { "type": "string", "minLength": 1 },
            "negate": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "pattern"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/identifier" },
            "kind": { "const": "final_message_matches" },
            "pattern": {
              "type": "string",
              "minLength": 1,
              "description": "A regular expression matched deterministically against trial.final_message. This is pattern matching, not semantic judgment. final_message_states is barred from machine-graded labels: no sealed label may contain a kind whose grading is manual."
            },
            "negate": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
