{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix.local/experiments/frontier-v1/manifest.schema.json",
  "title": "Frontier v1 corpus manifest",
  "description": "Counts, coverage, denominators, and digests for one tranche. It never carries expected outcomes, rationales, or run results.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "tranche", "sealed", "generator", "world_refs", "counts", "class_coverage", "family_coverage", "grading", "fixtures", "cases"],
  "properties": {
    "v": { "const": 1 },
    "tranche": { "$ref": "common.schema.json#/$defs/tranche" },
    "sealed": {
      "type": "boolean",
      "description": "True when label content lives outside this repository and only digests are recorded here."
    },
    "generator": {
      "type": "string",
      "minLength": 1,
      "description": "Exact command that regenerates this file."
    },
    "world_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pinnedRef" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "families", "fixtures", "labels"],
      "properties": {
        "cases": { "type": "integer", "minimum": 0 },
        "families": { "type": "integer", "minimum": 0 },
        "fixtures": { "type": "integer", "minimum": 0 },
        "labels": { "type": "integer", "minimum": 0 }
      }
    },
    "class_coverage": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/caseClass" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "family_coverage": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/familyId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classes", "cases"],
        "properties": {
          "classes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/caseClass" },
            "uniqueItems": true
          },
          "cases": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labelled_cases", "cases_with_grading_script", "checks", "checks_by_kind"],
      "properties": {
        "labelled_cases": { "type": "integer", "minimum": 0 },
        "cases_with_grading_script": { "type": "integer", "minimum": 0 },
        "checks": { "type": "integer", "minimum": 0 },
        "checks_by_kind": {
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/identifier" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "family_id", "digest"],
        "properties": {
          "fixture_id": { "$ref": "common.schema.json#/$defs/fixtureId" },
          "family_id": { "$ref": "common.schema.json#/$defs/familyId" },
          "digest": { "$ref": "common.schema.json#/$defs/digest" }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "class", "family_id", "input_digest", "sandbox_fixture", "world_ref", "label_digest"],
        "properties": {
          "case_id": { "$ref": "common.schema.json#/$defs/caseId" },
          "class": { "$ref": "common.schema.json#/$defs/caseClass" },
          "family_id": { "$ref": "common.schema.json#/$defs/familyId" },
          "input_digest": { "$ref": "common.schema.json#/$defs/digest" },
          "sandbox_fixture": { "$ref": "common.schema.json#/$defs/digest" },
          "world_ref": { "$ref": "common.schema.json#/$defs/digest" },
          "label_digest": {
            "oneOf": [{ "$ref": "common.schema.json#/$defs/digest" }, { "type": "null" }]
          }
        }
      }
    }
  },
  "$defs": {
    "pinnedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "source"],
      "properties": {
        "digest": { "$ref": "common.schema.json#/$defs/digest" },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative path of the document the digest was computed from."
        }
      }
    }
  }
}
