{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix.local/experiments/frontier-v1/withheld-labels.schema.json",
  "title": "Frontier v1 withheld-label digest registry",
  "description": "Outcome-free digests supplied by an independent evaluator. Full label content never enters the implementation workspace before the tranche opens.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "tranche", "labels"],
  "properties": {
    "v": { "const": 1 },
    "tranche": { "enum": ["validation", "held_out"] },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "label_digest", "grading_script"],
        "properties": {
          "case_id": { "$ref": "common.schema.json#/$defs/caseId" },
          "label_digest": { "$ref": "common.schema.json#/$defs/digest" },
          "grading_script": { "$ref": "common.schema.json#/$defs/digest" }
        }
      }
    }
  }
}
