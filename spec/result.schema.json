{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phoenix.local/spec/result.schema.json",
  "title": "Phoenix result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "world_build",
    "session_id",
    "act_id",
    "handle",
    "verb",
    "status",
    "result",
    "error",
    "text",
    "handles",
    "frontier",
    "refusal"
  ],
  "properties": {
    "v": { "const": 1 },
    "world_build": { "$ref": "#/$defs/digest" },
    "session_id": { "$ref": "#/$defs/sessionId" },
    "act_id": { "$ref": "#/$defs/actId" },
    "handle": { "$ref": "#/$defs/handleRef" },
    "verb": { "$ref": "#/$defs/identifier" },
    "status": { "enum": ["ok", "fail", "refused", "absent"] },
    "result": {
      "oneOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "error": {
      "oneOf": [
        { "$ref": "#/$defs/error" },
        { "type": "null" }
      ]
    },
    "text": { "type": "string", "minLength": 1 },
    "handles": { "$ref": "#/$defs/handleDelta" },
    "frontier": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/frontierEntry" }
    },
    "refusal": {
      "oneOf": [
        { "$ref": "#/$defs/refusal" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
      "then": {
        "properties": {
          "result": { "type": "object" },
          "error": { "type": "null" },
          "refusal": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "fail" } }, "required": ["status"] },
      "then": {
        "properties": {
          "error": { "$ref": "#/$defs/error" },
          "refusal": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "refused" } }, "required": ["status"] },
      "then": {
        "properties": {
          "result": { "type": "null" },
          "error": { "type": "null" },
          "refusal": { "$ref": "#/$defs/refusal" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "absent" } }, "required": ["status"] },
      "then": {
        "properties": {
          "result": { "type": "null" },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "const": "absent" },
              "message": { "const": "handle is not reachable" }
            }
          },
          "handles": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grant", "revoke"],
            "properties": {
              "grant": { "type": "array", "maxItems": 0 },
              "revoke": { "type": "array", "maxItems": 0 }
            }
          },
          "frontier": { "maxItems": 0 },
          "refusal": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^s_[A-Za-z0-9_-]{16,}$"
    },
    "actId": {
      "type": "string",
      "pattern": "^a_[A-Za-z0-9_-]{16,}$"
    },
    "handleRef": {
      "type": "string",
      "pattern": "^h_[A-Za-z0-9_-]{16,}$"
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "verb", "args"],
      "properties": {
        "handle": { "$ref": "#/$defs/handleRef" },
        "verb": { "$ref": "#/$defs/identifier" },
        "args": { "type": "object" },
        "state": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        }
      }
    },
    "handleGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "type", "label"],
      "properties": {
        "ref": { "$ref": "#/$defs/handleRef" },
        "type": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/digest" }
      }
    },
    "handleDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant", "revoke"],
      "properties": {
        "grant": {
          "type": "array",
          "items": { "$ref": "#/$defs/handleGrant" }
        },
        "revoke": {
          "type": "array",
          "items": { "$ref": "#/$defs/handleRef" },
          "uniqueItems": true
        }
      }
    },
    "frontierEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call", "why", "provenance", "score"],
      "properties": {
        "call": { "$ref": "#/$defs/call" },
        "why": { "type": "string", "minLength": 1, "maxLength": 80 },
        "provenance": { "enum": ["authored", "counted"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["what", "why", "instead"],
      "properties": {
        "what": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "instead": {
          "oneOf": [
            { "$ref": "#/$defs/call" },
            { "type": "null" }
          ]
        },
        "no_alternative": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "instead": { "type": "null" } }, "required": ["instead"] },
          "then": { "required": ["no_alternative"] },
          "else": { "not": { "required": ["no_alternative"] } }
        }
      ]
    }
  }
}
